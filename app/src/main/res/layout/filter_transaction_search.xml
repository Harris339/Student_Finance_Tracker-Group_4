<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@drawable/rounded_box_trans_search">

    <ImageButton
        android:id="@+id/btnExit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/baseline_cancel_24"

        android:contentDescription="Exit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/Heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Filters"
        android:textSize="18sp"
        android:textStyle="bold"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/Category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Category"
        android:layout_marginTop="16dp"
        android:textSize="16sp"
        android:textStyle="bold"

        app:layout_constraintTop_toBottomOf="@id/Heading"
        app:layout_constraintStart_toStartOf="parent"/>

    <Spinner
        android:id="@+id/spCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"

        app:layout_constraintStart_toEndOf="@id/Category"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/Category"
        app:layout_constraintBottom_toBottomOf="@id/Category"/>

    <TextView
        android:id="@+id/tvFreq"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Type"
        android:layout_marginTop="16dp"
        android:textSize="16sp"
        android:textStyle="bold"

        app:layout_constraintTop_toBottomOf="@id/Category"
        app:layout_constraintStart_toStartOf="parent"/>

    <Spinner
        android:id="@+id/spType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"

        app:layout_constraintStart_toEndOf="@id/Category"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvFreq"
        app:layout_constraintBottom_toBottomOf="@id/tvFreq"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/setBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apply Filters"
        style="@style/Widget.Material3.Button.OutlinedButton"

        android:layout_marginTop="16dp"

        app:backgroundTint="@color/button_bg"
        android:textColor="@color/button_text"
        app:strokeColor="@color/button_text"

        app:rippleColor="#22000000"

        app:layout_constraintEnd_toEndOf="@+id/spType"
        app:layout_constraintTop_toBottomOf="@+id/tvFreq"/>

</androidx.constraintlayout.widget.ConstraintLayout>