<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@drawable/rounded_box">

    <!-- Title -->
    <TextView
        android:id="@+id/labelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit values for "
        android:textSize="18sp"
        android:textColor="@color/white"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Netflix"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"

        app:layout_constraintStart_toEndOf="@id/labelText"
        app:layout_constraintBaseline_toBaselineOf="@id/labelText"/>

    <ImageButton
        android:id="@+id/btnExit"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/baseline_cancel_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Exit"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/labelText"/>

    <!-- Revert Section -->
    <TextView
        android:id="@+id/revertLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Revert payments"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginTop="16dp"

        app:layout_constraintTop_toBottomOf="@id/labelText"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/editAmount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter custom amount"
        android:textSize="14sp"
        android:textColorHint="@color/white"
        android:textColor="@color/white"
        android:layout_marginStart="8dp"

        app:layout_constraintStart_toEndOf="@id/revertLabel"
        app:layout_constraintEnd_toStartOf="@id/btnUndo"
        app:layout_constraintTop_toTopOf="@id/revertLabel"
        app:layout_constraintBottom_toBottomOf="@id/revertLabel" />

    <ImageButton
        android:id="@+id/btnUndo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/baseline_undo_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Undo Payment"
        app:layout_constraintEnd_toStartOf="@id/btnRedo"
        app:layout_constraintTop_toTopOf="@id/editAmount"
        app:layout_constraintBottom_toBottomOf="@id/editAmount"
        android:layout_marginEnd="8dp"/>

    <ImageButton
        android:id="@+id/btnRedo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/baseline_undo_24"
        android:rotationY="180"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Redo Payment"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/editAmount"
        app:layout_constraintBottom_toBottomOf="@id/editAmount"/>

    <!-- Edit category section -->
    <TextView
        android:id="@+id/categoryLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit category"
        android:textColor="@color/white"
        android:layout_marginTop="16sp"
        android:textStyle="bold"
        android:textSize="18sp"

        app:layout_constraintTop_toBottomOf="@+id/revertLabel"
        app:layout_constraintStart_toStartOf="parent"/>

    <Spinner
        android:id="@+id/spCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16sp"

        app:layout_constraintTop_toBottomOf="@id/revertLabel"
        app:layout_constraintStart_toEndOf="@+id/revertLabel"/>

</androidx.constraintlayout.widget.ConstraintLayout>