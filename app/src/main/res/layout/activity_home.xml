<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student Finance Tracker"
        android:textSize="28sp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/transactionBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to Transactions"/>

    <Button
        android:id="@+id/mainBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to Main Page"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/expenseBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to Expenses Page"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/chartBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View your analytics"
        android:layout_marginTop="12dp"/>

</LinearLayout>