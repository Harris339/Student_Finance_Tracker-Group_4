<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A1A1A"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Finance Tracker"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvUserEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:ellipsize="end"
                        android:maxLines="1"/>

                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnLogout"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_logout"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Sign out"/>

            </LinearLayout>

            <!-- Balance -->
            <TextView
                android:id="@+id/balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current Balance: "
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="#1E1E1E"
                android:padding="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>

            <!-- Pools card -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="POOLS"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1E1E1E"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="4dp"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/poolsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <TextView
                    android:id="@+id/tvNoPools"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No pools set up yet.\nGo to Charts to add income categories."
                    android:textColor="#55FFFFFF"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:visibility="visible"/>

            </LinearLayout>

            <!-- Savings Goals -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SAVINGS GOALS"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1E1E1E"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="4dp"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/savingsGoalsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <TextView
                    android:id="@+id/tvNoSavings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No savings goals set up yet"
                    android:textColor="#55FFFFFF"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:visibility="visible"/>

            </LinearLayout>

            <!-- Upcoming Bills -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="UPCOMING BILLS"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1E1E1E"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="4dp"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/upcomingBillsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <TextView
                    android:id="@+id/tvNoBills"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No bills due in the next 7 days"
                    android:textColor="#55FFFFFF"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:visibility="visible"/>
            </LinearLayout>

            <!-- Recent Activity -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RECENT ACTIVITY"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1E1E1E"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="4dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Last Income"
                        android:textColor="#888888"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tvLastIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#4DB6AC"
                        android:textSize="13sp"/>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2A2A2A"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Last Expense"
                        android:textColor="#888888"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tvLastExpense"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#FF6B6B"
                        android:textSize="13sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Quick Actions -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QUICK ACTIONS"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <Button
                    android:id="@+id/btnQuickIncome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Add Income"
                    android:backgroundTint="#2E7D5E"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnQuickExpense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Add Expense"
                    android:backgroundTint="#8B3A2A"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
